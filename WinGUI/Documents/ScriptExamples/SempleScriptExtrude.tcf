//Загрузка геометрии и баз данных
"Load project" "C:\Users\andre\Desktope\ProjectsAndModels\Models\PART_3.stp"
"Create task"
"Load material db" "C:\Users\andre\Desktope\ProjectsAndModels\Models\Materials_v4.jsf"
"Load function db" "C:\Users\andre\Desktope\ProjectsAndModels\Models\functions.jsf"

//Создаем точки
$p1 = "Create point by vector" "15" "17" "-7"
$p2 = "Create point by vector" "15" "16" "7"
$p3 = "Create point by vector" "15" "17" "0"

//Создаем кривые
$line1 = "Create curve" "$p3" "$p1"
$line2 = "Create curve" "$p1" "$p2"
$line3 = "Create curve" "$p2" "$p3"

//Настраиваем кривые
"Set mesh curve" "$line1" "4" "Progression" "1"
"Set mesh curve" "$line2" "4" "Progression" "1"
"Set mesh curve" "$line3" "4" "Progression" "1"

//Создаем поверхность
$surface1 = "Create surface" "curves forming the contour" "$line1,$line2,$line3"

//Настройка сетки
"Set min size" "0.1"
"Set max size" "5"
"Generate mesh" 

//Выполнение экструзии
$extrudeSet = "Extrude along curve" "$surface1" "20,19,14,11,8,7,1,50,47,44,41,40,35,32,29,26" "15" "5" "1"

//Создание групп
$grNameMaster = "Create surface nodes group" "$extrudeSet" 

$grNameSlave1 = "Create group by geometry objs" "0" "2" "25"
$grBeamName1 = "Connect with beams" "2" "10" "$grNameMaster" "$grNameSlave1"

$grNameSlave2 = "Create group by geometry objs" "0" "2" "7"
$grBeamName2 = "Connect with beams" "2" "10" "$grNameMaster" "$grNameSlave2"

$grNameSlave3 = "Create group by geometry objs" "0" "2" "5"
$grBeamName3 = "Connect with beams" "2" "10" "$grNameMaster" "$grNameSlave3"

$gr = "Create group" "$grBeamName3"

//Создание 1Д материал
"Create beam material" "Сталь_30ХГСА" "$gr" "1" "2" "15"
