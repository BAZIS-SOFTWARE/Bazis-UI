@startuml

title Перерисовка сцены BazisGUI через RequestRedraw()\nКто запрашивает кадр, кто его рисует. Пояснения, номера строк и порядок перехода — DisplayObjects.md

hide empty members
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 55
skinparam packageStyle rectangle

legend top left
  <b>Стереотипы</b>
  <<new>>     — добавить
  <<reuse>>   — существующий класс, не меняется
  <<caller>>  — явный DisplayObjects() заменяется на RequestRedraw()
  <<drop>>    — явный DisplayObjects() удаляется: кадр уже запрашивает ModelView.Changed
  <<sync>>    — кадр нужен до выхода из метода: RenderNow()
  <<next>>    — следующий шаг перехода (SceneController.RenderRequested)
end legend

' =====================================================================
package "Источники запроса кадра — GUI/Methods, BaseForm.cs" {

  class "Сцена: ввод мышью и клавиатурой" as SceneInput <<caller>> {
    {method} MouseEvents.GlControl_MouseMove()  ×3
    {method} MouseEvents.GlControl_MouseWheel()
    {method} MouseEvents.GlControl_MouseUp()  ×2
    {method} SceneEvents.GlControl_KeyDown()  Esc, C, F
    {method} SceneEvents.menuItem_SetRotPoint_Click()
  }

  class "Сцена: панели инструментов" as SceneTools <<caller>> {
    {method} ViewToolStrip.btnXY/ZX/ZY_Click()  ×3
    {method} ViewToolStrip.btnRotX/Y/Z_Click()  ×3
    {method} ViewToolStrip.btnRotHor90/Vert90_Click()  ×2
    {method} FitToScreen.btnFitToScreen_Click()
    {method} ShowBasis.btnBazis_Click()
    {method} ShowCountours.btnBorder_Click()
    {method} DisplayToolStrip.btnShowNormals_Click()
    {method} AdvanceSelection.DispatchSelection()
    {method} ColorObjects.ColorObjects()
  }

  class "Настройки" as SettingsCallers <<caller>> {
    {method} MainMenuEvents.SetSettingsToConfig()  ×6
    ..
    {method} фон, освещение, прозрачность,
    {method} проекция, интенсивность, источник света
  }

  class "Навигатор" as NavigatorCallers <<caller>> {
    {method} DelSetEvent.navigator_DelSetEvent()
    {method} DelElementsEvent.DelElements()
    {method} DelAllObjectsEvent.navigator_DelAllObjectsEvent()
    {method} ShowHideDelObject.navigator_DelObjectEvent()
    {method} NavigatorEvents.navigator_RemoveResultsEvent()
    {method} NavigatorEvents.navigator_HideResultsEvent()
    {method} SelectGeoEvent: кнопки «Показать номера»  ×4
    {method} SelectGeoEvent.ShowNodesOnCurves()  ×2
    {method} GetSurfaceProperty: номера точек поверхности
    {method} SelectTimeEvent.ShowResults()
  }

  class "Консоль" as ConsoleCallers <<caller>> {
    {method} ConsoleEvents.CreateMesh2DPoligon()
    {method} ConsoleEvents.console_ModelShiftCoordinateEvent()
    {method} ConsoleEvents.console_ModelRotateEvent()
    {method} BeamConnection.BeamConnection()
    {method} FindCoincidentNodes.FindCoincidentNodes()
    {method} NodesShiftCoordinate.console_NodesShiftCoordinate()
    {method} MergeElementSets.MergeElementSets()  (вызова нет — добавить)
  }

  class "Сетка и геометрия" as MeshGeomCallers <<caller>> {
    {method} GenerateMesh2DEvent / GenerateMesh3DEvent
    {method} GreateBoundaryMesh.CreateBoundaryMesh()
    {method} QuadMesh / RefineMesh
    {method} GeometryBuilder.GeometryParser() / PresentExtrude()
    {method} CreateChamfer.CreateChamfer() / ClearChamferPreview()
    {method} PreviewChamfer.UpdateChamferPreview()
    {method} ChangeMeshObjectProperty.ChangeNode/ElementProperty()
  }

  class "Инструменты и результаты" as ToolCallers <<caller>> {
    {method} UtilityToolStrip: измерения  ×5
    {method} UtilityToolStrip: сечение  ×3
    {method} UtilityToolStrip: отсечение плоскостью  ×3, CaptureData()
    {method} Reflect.отзеркаливание...()  ×4
    {method} CreatePlot.построитьГрафик...()  ×2, SelectContainerAsync()  ×2
    {method} CreateDiagramm.построитьДиаграмму...()
    {method} CreateAnimation: FormClosed
    {method} Checking.CheckPlayerControl_StopCheckingEvent()
    {method} BasePage.AsyncMethodContainer()  ×2
  }

  class "BaseForm: жизненный цикл проекта" as ProjectCallers <<caller>> {
    {method} BaseForm_Load()
    {method} создатьToolStripMenuItem_Click()
    {method} OpenProject()
    {method} добавитьСеткуToolStripMenuItem_Click()
  }

  class "Изменения только представления" as DropCallers <<drop>> {
    {method} SelectMeshEvent: «Показать» / «Скрыть»  ×6
    {method} SelectMeshEvent: «Удалить»  ×3 (дубль DelElements)
    {method} ShowHideElementsEvent.ShowElements()
    {method} SelectCondEvent.Navigator_SelectCondEvent()
    {method} SelectSetEvent: «Показать смежные»
    {method} SelectByRect.SelectByRect()
    {method} AdvanceSelection.SelectionControl_SelectInSet()
    {method} AdvanceSelection.SelectionControl_SelectInGeom()
    {method} AdvanceSelection.BackColorToAllObjects()
    {method} SelectObjects.SelectedObjects (set)
  }

  class "Кадр нужен сразу" as SyncCallers <<sync>> {
    {method} CreateAnimation.CreateGIFAnimation()
    ..
    {method} ShowResults() → RenderNow() → CreateScreenShot()
  }
}

' =====================================================================
package "BazisCore / OperationalController" {
  interface IModelView <<reuse>> {
    + {event} Changed : EventHandler
    + Select() / Deselect() / SetSelection()
    + SetVisible() / HideSelected() / ShowAll()
    + BeginUpdate() : IDisposable
  }
}

' =====================================================================
package "Хост WinForms — GUI/Methods/Scene" {

  class BaseForm <<partial>> {
    + RequestRedraw() : void <<new>>
    + RenderNow() : void <<new>>
    - DisplayObjects() : void
    - ModelView_Changed(sender, e) : void
    - RefreshModelViewBuffers() : void
    - SceneInitialization(sender, args) : void
  }

  class GLControl <<reuse>> {
    + {event} Paint
    + Invalidate() : void
    + Refresh() : void
    + SwapBuffers() : void
  }
}

' =====================================================================
package "SceneCore" {
  class SceneController <<reuse>> {
    + {event} RenderRequested : Action
    + DisplayObjects() : void
  }

  class SceneRenderer <<reuse>> {
    + Render(context : IRenderContext) : void
  }
}

' ---------------- источники → запрос кадра ----------------
SceneInput        ..> BaseForm : RequestRedraw()
SceneTools        ..> BaseForm : RequestRedraw()
SettingsCallers   ..> BaseForm : RequestRedraw()
NavigatorCallers  ..> BaseForm : RequestRedraw()
ConsoleCallers    ..> BaseForm : RequestRedraw()
MeshGeomCallers   ..> BaseForm : RequestRedraw()
ToolCallers       ..> BaseForm : RequestRedraw()
ProjectCallers    ..> BaseForm : RequestRedraw()
SyncCallers       ..> BaseForm : RenderNow()

' ---------------- представление модели ----------------
DropCallers       ..> IModelView : Select / SetVisible / ClearSelection
IModelView        --> BaseForm : Changed → ModelView_Changed()\nRefreshModelViewBuffers() + RequestRedraw()

' ---------------- единственный путь отрисовки ----------------
BaseForm          --> GLControl : RequestRedraw → Invalidate()\nRenderNow → Refresh()
GLControl         --> BaseForm : Paint → DisplayObjects()
BaseForm          --> SceneController : DisplayObjects()
SceneController   --> SceneRenderer : Render(BuildContext())

' ---------------- следующий шаг ----------------
SceneController   ..> BaseForm : <<next>> RenderRequested → RequestRedraw()

note right of BaseForm
  RequestRedraw() — только помечает сцену
  «грязной» (Invalidate). Несколько запросов
  до ближайшего WM_PAINT склеиваются в один кадр.
  Безопасен из любого потока (BeginInvoke).

  RenderNow() — Refresh(): Paint выполняется
  синхронно, до возврата из метода. Только
  для захвата кадра с экрана.

  DisplayObjects() становится private и
  вызывается только из scene.Paint.
  SwapBuffers() остаётся внутри него.
end note

note bottom of DropCallers
  Эти обработчики меняют только IModelView.
  Кадр уже запрашивает ModelView_Changed,
  поэтому явный вызов удаляется, а не
  заменяется на RequestRedraw().
end note

note bottom of SyncCallers
  CreateScreenShot() снимает экран через
  CopyFromScreen. С Invalidate() кадр ещё не
  нарисован — все кадры GIF окажутся одинаковыми.
end note

@enduml
