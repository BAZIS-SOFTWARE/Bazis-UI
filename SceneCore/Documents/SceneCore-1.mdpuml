@startuml
title SceneCore-1 — камера и преобразования
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "SceneCore. Контракты" {
  interface ISceneCamera {
    + Width : int [get, set]
    + Height : int [get, set]
    + AngleOfProjection : float [get, set]
    + Position : Point3D [get, set]
    + SetViewMatrix(matrix: Matrix<float>) : void
    + GetViewMatrix() : Matrix<float>
    + GetSceneCoordOfScreenVector(x: float, y: float) : Point3D
    + Move(newMousePosition, mousePosition, scaleFactor) : void
    + GetSceenCoord(x: double, y: double, z: double) : Point3D
    + GetSceenCoord(point: Point3D) : Point3D
    + GetSceenCoord(deltaX: int, deltaY: int, depth: float, scaleFactor: float) : Point3D
    + GetScreenCoord(coord: Point3D) : ViewportPoint
    + Rotate(axis: ViewAxis, angle: float) : void
    + Rotate(dx: float, dy: float, axis: ViewAxis, angle: float) : void
    + SetOnPlane(plane: ViewPlane, scaleFactor: float) : void
  }
}
package "SceneCore. Камера" {
  class SceneCamera {
    + ScaleFactor : float [get]
    + Initialize(moveX: float, moveY: float, moveZ: float) : void
    + GetProjectionMatrix() : Matrix<float>
    + Scale(scaleFactor: float) : void
    + SetRotationCentre(modelPoint: Point3D) : void
    + ResetPan() : void
  }
  class GlMatrix <<static>> {
    + Identity() : Matrix<float>
    + Translate(m: Matrix<float>, x: double, y: double, z: double) : Matrix<float>
    + Rotate(m: Matrix<float>, angle: float, x: double, y: double, z: double) : Matrix<float>
    + Transform(m: Matrix<float>, x: double, y: double, z: double, w: float) : Point3D
  }
}
package "Geometry. Координаты" {
  class Point3D <<внешний>>
}
package "SceneCore. Координаты" {
  class "ViewportPoint\nSceneCore-2" as ViewportPoint <<ссылка>> [[SceneCore-2.mdpuml SceneCore-2]]
}

SceneCamera ..|> ISceneCamera
SceneCamera --> GlMatrix
SceneCamera --> Point3D
ISceneCamera --> ViewportPoint

note bottom of GlMatrix
  Входные координаты double; матрица OpenGL остаётся float.
  [[SceneCore.mdpuml Назад к SceneCore]]
  [[SceneCore-2.mdpuml Геометрия и буферы]]
end note
@enduml
