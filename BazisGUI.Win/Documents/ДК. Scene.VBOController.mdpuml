@startuml

class VBOController
class VBOController
class Advanced3DClipper
class ClipPlaneRenderer

class VBObject
interface IVBObject
class SurfaceObjects
class PointObjects
class LineObjects
class BoundingBox
class ClipPlane
class ShaderProgramCreator

IVBObject <|.. VBObject
