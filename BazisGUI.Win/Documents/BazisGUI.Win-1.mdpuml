@startuml
title BazisGUI.Win-1 — от запроса кадра до OpenGL
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.Win. Сцена" {
  class "BaseForm (часть Scene)" as BaseForm {
    + Position : ModelPoint3D [get, set]
    + SceneInitialization(sender, args) : void
    + RequestRedraw() : void
    + RenderNow() : void
    + GetSceenCoord(x: double, y: double, z: double) : CameraPoint3D
    + GetSceenCoord(point: Point3D) : CameraPoint3D
    + GetSceenCoord(deltaX: int, deltaY: int, depth: float, scaleFactor: float) : ModelVector3D
    + GetSceneCoordOfScreenVector(x: float, y: float) : ModelVector3D
    + GetScreenCoord(coord: CameraPoint3D) : ViewportPoint
    + SetRotationCentre(modelPoint: ModelPoint3D) : void
    + SelectByPoint(sets, point: ViewportPoint, isSelected) : bool
    - GetVisiblePickObjects(sourceSet, elementByNumber) : IEnumerable<ScenePickObject>
    - GetCadSurfacePoints(number: int) : IEnumerable<Point3D>
    - GetElementSurfacePoints(element: ISurfaceElement) : IEnumerable<Point3D>
    - SelectObjects(point: ViewportPoint, isSelected: bool) : void
    - DisplayObjects() : void
    + {event} DisplayGeometryObjectEvent
    + {event} DisplayText3DEvent
    + {event} DisplayText2DEvent
  }
}
package "BazisGUI.SceneCore. Сцена" {
  class SceneController <<внешний>> {
    + Initialization() : void
    + DisplayObjects() : void
    + {event} InfoRequested
  }
}
package "BazisGUI.SceneCore. Выбор" {
  class ScenePickObject <<внешний>>
}
package "BazisGUI.SceneCore. Координаты" {
  class ModelPoint3D <<внешний>>
  class CameraPoint3D <<внешний>>
  class ModelVector3D <<внешний>>
  class ViewportPoint <<внешний>>
}
package "OperationalController. Проект" {
  class ProjectController <<внешний>>
}
package "Model. Поверхностные элементы" {
  interface ISurfaceElement <<внешний>>
}
package "Geometry. Координаты" {
  class Point3D <<внешний>>
}

BaseForm --> SceneController : инициализация и кадр
BaseForm --> ScenePickObject : точки ModelPoint3D
BaseForm --> ModelPoint3D : центр вращения
BaseForm --> CameraPoint3D : проекция и выбор
BaseForm --> ModelVector3D : перенос камеры
BaseForm --> ViewportPoint : выбор с экрана
BaseForm --> ProjectController : модель и представление
BaseForm --> ISurfaceElement : триангуляция граней
BaseForm --> Point3D : входные координаты

note right of BaseForm
  RequestRedraw ставит перерисовку в очередь UI.
  RenderNow рисует синхронно для захвата кадра.
  Мировые координаты Point3D хранятся как double.
  [[BazisGUI.Win.mdpuml Назад к BazisGUI.Win]]
end note
note bottom of SceneController
  Внешний проект: показана только точка входа.
end note
@enduml
