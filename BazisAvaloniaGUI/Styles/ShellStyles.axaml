<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector=":is(Window)">
    <Setter Property="Icon" Value="avares://BazisAvaloniaGUI/Assets/IconShort_32.ico" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Win32Properties.WindowCornerPreference" Value="DoNotRound" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="#E1E1E1" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="BorderBrush" Value="#969696" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="#C5C5C5" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="#C5C5C5" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="#F0F0F0" />
    <Setter Property="Foreground" Value="#626262" />
    <Setter Property="BorderBrush" Value="#CBCBCB" />
  </Style>
  <!-- ComboBox: поле и пункты 20 px. Отступы Fluent рассчитаны на 32 px и обрезают текст. -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="BorderBrush" Value="#7A7A7A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ComboBox:pressed">
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox:disabled">
    <Setter Property="Background" Value="#F8F8F8" />
    <Setter Property="BorderBrush" Value="#CACACA" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#7A7A7A" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="#F0F0F0" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="#C5C5C5" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="#7B7B7B" />
  </Style>
  <Style Selector="MenuItem /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="MenuItem Separator">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="#F0F0F0" Padding="12,4">
          <Border Height="1" Background="#969696" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Background" Value="Silver" />
    <Setter Property="BorderBrush" Value="Black" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- CheckBox и RadioButton: индикатор 16 x 16, рамка 1/2/3 px в обычном состоянии, при наведении и нажатии.
       Цвета задаются в ShellResources.axaml; рамку отмеченного CheckBox Fluent рисует цветом заливки. -->
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="MinHeight" Value="16" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="#000000" />
  </Style>
  <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="CheckBox:disabled /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="#CACACA" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="RadioButton /template/ Ellipse#OuterEllipse, RadioButton /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="RadioButton /template/ Ellipse#CheckGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse, RadioButton:pointerover /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="RadioButton:pressed /template/ Ellipse#OuterEllipse, RadioButton:pressed /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="StrokeThickness" Value="3" />
  </Style>
  <!-- TabControl: вкладки без фона на общей линии 1 px #ADADAD, состояние показывает подчёркивание. -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#ADADAD" BorderThickness="0,0,0,1">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
          <Border Name="TabUnderline" Height="0" VerticalAlignment="Bottom" Background="#000000" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#TabUnderline">
    <Setter Property="Height" Value="1" />
  </Style>
  <!-- Содержимое вкладки наследует свойства TabItem, поэтому начертание и цвет задаются только заголовку. -->
  <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#TabUnderline">
    <Setter Property="Height" Value="2" />
  </Style>
  <Style Selector="TabItem:pressed /template/ Border#TabUnderline">
    <Setter Property="Height" Value="3" />
  </Style>
  <Style Selector="TabItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#7B7B7B" />
  </Style>
  <Style Selector="TabItem:disabled /template/ Border#TabUnderline">
    <Setter Property="Background" Value="#7B7B7B" />
  </Style>
</Styles>
