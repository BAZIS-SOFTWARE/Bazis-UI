<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigator="using:BazisAvaloniaGUI.Navigator"
      xmlns:properties="using:BazisAvaloniaGUI.Properties"
      xmlns:player="using:BazisAvaloniaGUI.Player"
      x:Class="BazisAvaloniaGUI.Shell.NavigatorPage">
  <Grid.RowDefinitions>
    <RowDefinition Height="298*" MinHeight="25"/>
    <RowDefinition Height="8"/>
    <RowDefinition Height="253*" MinHeight="25"/>
  </Grid.RowDefinitions>
  <Border BorderBrush="#7A7A7A" BorderThickness="1" Background="#F0F0F0">
    <Grid RowDefinitions="20,*">
      <Border Background="Gainsboro" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
        <TextBlock x:Name="navigatorHeader" Foreground="Black" Margin="14,0,0,0"
                   VerticalAlignment="Center"/>
      </Border>
      <navigator:NavigatorControl x:Name="navigator" Grid.Row="1"/>
    </Grid>
  </Border>
  <GridSplitter Grid.Row="1" Height="8" ResizeDirection="Rows" Background="#F0F0F0"/>
  <Grid Grid.Row="2" RowDefinitions="*,Auto">
    <Border BorderBrush="#7A7A7A" BorderThickness="1" Background="#F0F0F0">
      <Grid RowDefinitions="20,*">
        <Border Background="Gainsboro" BorderBrush="#A0A0A0" BorderThickness="0,0,0,1">
          <TextBlock x:Name="propertiesHeader" Foreground="Black" Margin="14,0,0,0"
                     VerticalAlignment="Center"/>
        </Border>
        <properties:PropertiesPanelControl x:Name="propertiesPanel" Grid.Row="1"/>
      </Grid>
    </Border>
    <player:PlayerControl x:Name="checkPlayerControl" Grid.Row="1"
                          SpeedValue="500" StartValue="0" StopValue="100" CurrentValue="50"/>
  </Grid>
</Grid>
