<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scene="using:BazisAvaloniaGUI.Scene"
             xmlns:loc="using:BazisAvaloniaGUI.Localization"
             x:Class="BazisAvaloniaGUI.Scene.SceneView"
             FontFamily="Sans Serif"
             FontSize="12"
             Foreground="#FF000000">

    <!--
        Оформление оверлея сцены по «Правилам для переноса на Авалонию» (.vscode).
        «Select» — настоящий ComboBox со списком наборов; «View» — ToggleButton, эмулирующий
        ComboBox и раскрывающий панель кнопок-иконок. Кнопки внутри панелей — по правилу Button.
        Шрифт: Sans Serif, 12 кегль, цвет 000000. Скруглений нет — сохраняем угловатость исходного интерфейса.
        Высота ВСЕХ элементов управления в этом контроле — 28px, кнопки-иконки квадратные 28x28
        (ширину не фиксируем только у ComboBox и ToggleButton-«якорей»).

        Палитра:
            Button        Default  фон FFFFFF, обводка 1px 969696
                          Hover    фон C5C5C5, обводка 1px 969696
                          Pressed  фон C5C5C5, обводка 2px 969696
                          Checked  фон FFFFFF, обводка 2px FFA500 (кнопки режимов)
                          Disabled фон F0F0F0, обводка 1px CBCBCB, текст 626262, иконка 50%
            ComboBox /    Default  фон FFFFFF, обводка 1px 7A7A7A, стрелка вниз
            ToggleButton  Hover    фон FFFFFF, обводка 2px 7A7A7A
            (как ComboBox) Pressed фон FFFFFF, обводка 3px 7A7A7A
                          Selected фон FFFFFF, обводка 1px 7A7A7A, стрелка вверх,
                                   список: фон FFFFFF, обводка 1px 7A7A7A
                          Пункт списка 20px: Default фон FFFFFF, Hover E5E5E5, Pressed D5D5D5
                          Disabled фон F8F8F8, обводка 1px CACACA, стрелка 50%
    -->
    <UserControl.Resources>
        <!-- Fluent использует эти ресурсы внутри панелей выпадающих меню. -->
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
		<!-- Кнопка-иконка 28x28 (единая высота элементов панели, см. заголовок файла).
		     Для текстовых кнопок задавать Width явно: в теме он фиксирован. -->
		<ControlTheme x:Key="SceneButtonTheme" TargetType="Button">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="0">
						<ContentPresenter Name="PART_ContentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
				</ControlTemplate>
			</Setter>

			<!-- Default -->
			<Setter Property="Background" Value="#FFFFFFFF"/>
			<Setter Property="BorderBrush" Value="#FF969696"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF000000"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>

			<!-- Hover -->
			<Style Selector="^:pointerover">
				<Setter Property="Background" Value="#FFC5C5C5"/>
				<Setter Property="BorderBrush" Value="#FF969696"/>
				<Setter Property="BorderThickness" Value="1"/>
			</Style>

			<!-- Pressed -->
			<Style Selector="^:pressed">
				<Setter Property="Background" Value="#FFC5C5C5"/>
				<Setter Property="BorderBrush" Value="#FF969696"/>
				<Setter Property="BorderThickness" Value="2"/>
			</Style>

			<!-- Disabled -->
			<Style Selector="^:disabled">
				<Setter Property="Background" Value="#FFF0F0F0"/>
				<Setter Property="BorderBrush" Value="#FFCBCBCB"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Foreground" Value="#FF626262"/>
			</Style>
		</ControlTheme>

		<!-- Кнопка-переключатель внутри раскрытой панели (28x28): визуал по правилу Button; включённый
		     (активный) режим показываем нажатым состоянием той же палитры. -->
		<ControlTheme x:Key="SceneButtonToggleTheme" TargetType="ToggleButton">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="0">
						<ContentPresenter Name="PART_ContentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
				</ControlTemplate>
			</Setter>

			<!-- Default -->
			<Setter Property="Background" Value="#FFFFFFFF"/>
			<Setter Property="BorderBrush" Value="#FF969696"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF000000"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>

			<!-- Hover -->
			<Style Selector="^:pointerover">
				<Setter Property="Background" Value="#FFC5C5C5"/>
				<Setter Property="BorderBrush" Value="#FF969696"/>
				<Setter Property="BorderThickness" Value="1"/>
			</Style>

			<!-- Pressed -->
			<Style Selector="^:pressed">
				<Setter Property="Background" Value="#FFC5C5C5"/>
				<Setter Property="BorderBrush" Value="#FF969696"/>
				<Setter Property="BorderThickness" Value="2"/>
			</Style>

			<!-- Selected (включённый режим) — активная кнопка: фон остаётся белым, активность — оранжевой рамкой -->
			<Style Selector="^:checked">
				<Setter Property="Background" Value="#FFFFFFFF"/>
				<Setter Property="BorderBrush" Value="#FFFFA500"/>
				<Setter Property="BorderThickness" Value="2"/>
			</Style>

			<!-- Disabled -->
			<Style Selector="^:disabled">
				<Setter Property="Background" Value="#FFF0F0F0"/>
				<Setter Property="BorderBrush" Value="#FFCBCBCB"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Foreground" Value="#FF626262"/>
			</Style>
		</ControlTheme>

		<!-- «Якорь» раскрывающейся панели на ToggleButton — эмуляция ComboBox: высота 28px (как у кнопок
		     панели), стрелка справа (Default/Hover/Pressed — вниз, Selected — вверх). Используется для панели видов. -->
		<ControlTheme x:Key="SceneDropdownToggleTheme" TargetType="ToggleButton">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="0">
						<Panel>
							<ContentPresenter Name="PART_ContentPresenter"
											  Content="{TemplateBinding Content}"
											  ContentTemplate="{TemplateBinding ContentTemplate}"
											  Padding="{TemplateBinding Padding}"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Center"
											  HorizontalContentAlignment="Left"
											  VerticalContentAlignment="Center"/>
							<!-- Позиция стрелки (Margin/HorizontalAlignment) задаётся стилями ниже:
							     в шаблоне их нельзя задавать локально, иначе стиль их не перебьёт. -->
							<Path Name="PART_Arrow"
									  Data="M 0,0 L 4,4 L 0,8"
									  Stroke="#FF000000" StrokeThickness="1.5"
									  VerticalAlignment="Center"
									  RenderTransformOrigin="50%,50%"/>
						</Panel>
					</Border>
				</ControlTemplate>
			</Setter>

			<!-- Default: фон FFFFFF, обводка 1px 7A7A7A -->
			<Setter Property="Background" Value="#FFFFFFFF"/>
			<Setter Property="BorderBrush" Value="#FF7A7A7A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF000000"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>

			<!-- Стрелка смотрит вниз (Default/Hover/Pressed) -->
			<Style Selector="^ /template/ Path#PART_Arrow">
				<Setter Property="RenderTransform" Value="rotate(90deg)"/>
				<Setter Property="Transitions">
					<Transitions>
						<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
					</Transitions>
				</Setter>
			</Style>

			<!-- Hover: обводка 2px 7A7A7A -->
			<Style Selector="^:pointerover">
				<Setter Property="BorderThickness" Value="2"/>
			</Style>

			<!-- Pressed: обводка 3px 7A7A7A -->
			<Style Selector="^:pressed">
				<Setter Property="BorderThickness" Value="3"/>
			</Style>

			<!-- Selected (список раскрыт): стандартная обводка 1px 7A7A7A, стрелка вверх -->
			<Style Selector="^:checked">
				<Setter Property="BorderThickness" Value="1"/>
			</Style>
			<Style Selector="^:checked /template/ Path#PART_Arrow">
				<Setter Property="RenderTransform" Value="rotate(270deg)"/>
			</Style>

			<!-- Disabled: фон F8F8F8, обводка 1px CACACA, стрелка 50% -->
			<Style Selector="^:disabled">
				<Setter Property="Background" Value="#FFF8F8F8"/>
				<Setter Property="BorderBrush" Value="#FFCACACA"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Foreground" Value="#FF626262"/>
			</Style>
			<Style Selector="^:disabled /template/ Path#PART_Arrow">
				<Setter Property="Opacity" Value="0.5"/>
			</Style>

			<!-- Вариант стрелки "влево" (класс ArrowLeft): при раскрытии стрелка смотрит влево,
			     а не вверх — для панелей, которые раскрываются вбок. -->
			<Style Selector="^.ArrowLeft:checked /template/ Path#PART_Arrow">
				<Setter Property="RenderTransform" Value="rotate(180deg)"/>
			</Style>

			<!-- Стрелка-индикатор: по умолчанию прижата вправо (на 8px левее исходного). -->
			<Style Selector="^ /template/ Path#PART_Arrow">
				<Setter Property="HorizontalAlignment" Value="Right"/>
				<Setter Property="Margin" Value="6,0,10,0"/>
			</Style>

			<!-- Кнопка только со стрелкой без подписи (DisplayStatesToggle): стрелка по центру кнопки. -->
			<Style Selector="^.ArrowCenter /template/ Path#PART_Arrow">
				<Setter Property="HorizontalAlignment" Value="Center"/>
				<Setter Property="Margin" Value="0"/>
			</Style>
		</ControlTheme>
		<!-- Пункт выпадающего списка ComboBox (правило ComboBox): высота 20px, фон FFFFFF,
		     пункт под курсором — Hover E5E5E5, Pressed D5D5D5. -->
		<ControlTheme x:Key="SceneComboBoxItemTheme" TargetType="ComboBoxItem">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Border"
							Background="{TemplateBinding Background}"
							CornerRadius="0">
						<ContentPresenter Name="PART_ContentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Center"
										  HorizontalContentAlignment="Left"
										  VerticalContentAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>

			<!-- Default -->
			<Setter Property="Background" Value="#FFFFFFFF"/>
			<Setter Property="Foreground" Value="#FF000000"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="MinHeight" Value="20"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>

			<!-- Hover: фон E5E5E5 -->
			<Style Selector="^:pointerover">
				<Setter Property="Background" Value="#FFE5E5E5"/>
			</Style>

			<!-- Pressed: фон D5D5D5 -->
			<Style Selector="^:pressed">
				<Setter Property="Background" Value="#FFD5D5D5"/>
			</Style>

			<!-- Disabled -->
			<Style Selector="^:disabled">
				<Setter Property="Background" Value="#FFF8F8F8"/>
				<Setter Property="Foreground" Value="#FF626262"/>
			</Style>
		</ControlTheme>

		<!-- ComboBox (правило ComboBox, высота 28px): выбранное значение + стрелка справа, выпадающий список
		     — фон FFFFFF, обводка 1px 7A7A7A (только у списка, не у пунктов). -->
		<ControlTheme x:Key="SceneComboBoxTheme" TargetType="ComboBox">
			<Setter Property="Template">
				<ControlTemplate>
					<Grid ColumnDefinitions="*,Auto">
						<Border Name="PART_Border"
								Grid.ColumnSpan="2"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="0"/>
						<TextBlock Name="PART_Placeholder"
								   Grid.Column="0"
								   Text="{TemplateBinding PlaceholderText}"
								   Foreground="{TemplateBinding PlaceholderForeground}"
								   Padding="{TemplateBinding Padding}"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Left"
								   IsVisible="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}"/>
						<ContentPresenter Name="PART_ContentPresenter"
										  Grid.Column="0"
										  Content="{TemplateBinding SelectionBoxItem}"
										  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Center"
										  HorizontalContentAlignment="Left"
										  VerticalContentAlignment="Center"/>
						<Path Name="PART_Arrow"
							  Grid.Column="1"
							  Data="M 0,0 L 4,4 L 0,8"
							  Stroke="#FF000000" StrokeThickness="1.5"
							  Margin="6,0,10,0"
							  VerticalAlignment="Center"
							  RenderTransformOrigin="50%,50%"/>
						<Popup Name="PART_Popup"
							   WindowManagerAddShadowHint="False"
							   IsLightDismissEnabled="True"
							   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
							   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
							   MaxHeight="{TemplateBinding MaxDropDownHeight}"
							   Placement="BottomEdgeAlignedLeft">
							<Border Background="#FFFFFFFF"
									BorderBrush="#FF7A7A7A"
									BorderThickness="1"
									CornerRadius="0">
								<ScrollViewer HorizontalScrollBarVisibility="Disabled"
											  VerticalScrollBarVisibility="Auto">
									<ItemsPresenter Name="PART_ItemsPresenter"
													ItemsPanel="{TemplateBinding ItemsPanel}"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter>

			<!-- Default: фон FFFFFF, обводка 1px 7A7A7A -->
			<Setter Property="Background" Value="#FFFFFFFF"/>
			<Setter Property="BorderBrush" Value="#FF7A7A7A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#FF000000"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="PlaceholderForeground" Value="#FF7A7A7A"/>

			<!-- Стрелка смотрит вниз (Default/Hover/Pressed) -->
			<Style Selector="^ /template/ Path#PART_Arrow">
				<Setter Property="RenderTransform" Value="rotate(90deg)"/>
				<Setter Property="Transitions">
					<Transitions>
						<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
					</Transitions>
				</Setter>
			</Style>

			<!-- Hover: обводка 2px 7A7A7A -->
			<Style Selector="^:pointerover">
				<Setter Property="BorderThickness" Value="2"/>
			</Style>

			<!-- Pressed: обводка 3px 7A7A7A -->
			<Style Selector="^:pressed">
				<Setter Property="BorderThickness" Value="3"/>
			</Style>

			<!-- Selected (список раскрыт): обводка 1px 7A7A7A, стрелка вверх -->
			<Style Selector="^:dropdownopen">
				<Setter Property="BorderThickness" Value="1"/>
			</Style>
			<Style Selector="^:dropdownopen /template/ Path#PART_Arrow">
				<Setter Property="RenderTransform" Value="rotate(270deg)"/>
			</Style>

			<!-- Disabled: фон F8F8F8, обводка 1px CACACA, стрелка 50% -->
			<Style Selector="^:disabled">
				<Setter Property="Background" Value="#FFF8F8F8"/>
				<Setter Property="BorderBrush" Value="#FFCACACA"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Foreground" Value="#FF626262"/>
			</Style>
			<Style Selector="^:disabled /template/ Path#PART_Arrow">
				<Setter Property="Opacity" Value="0.5"/>
			</Style>
		</ControlTheme>

		<!-- Пункт контекстного меню сцены: иконка 16x16 + текст, высота строки 22px как в WinForms
		     (у меню ImageScalingSize = 24x24, но у пунктов ImageScaling = None — иконка нативная).
		     Свой шаблон безопасен: MenuItem ищет в шаблоне только PART_Popup и с null-проверкой,
		     а подменю здесь нет. -->
		<ControlTheme x:Key="SceneMenuItemTheme" TargetType="MenuItem">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="0">
						<Grid ColumnDefinitions="Auto,*">
							<ContentPresenter Name="PART_IconPresenter"
											  Grid.Column="0"
											  Content="{TemplateBinding Icon}"
											  Width="16" Height="16"
											  Margin="4,0,6,0"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
							<ContentPresenter Name="PART_HeaderPresenter"
											  Grid.Column="1"
											  Content="{TemplateBinding Header}"
											  ContentTemplate="{TemplateBinding HeaderTemplate}"
											  Margin="0,0,10,0"
											  HorizontalAlignment="Left"
											  VerticalAlignment="Center"/>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter>

			<!-- Default: прозрачный фон, ширина строки по содержимому -->
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#FF000000"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>

			<!-- Hover / выбор с клавиатуры / нажатие -->
			<Style Selector="^:pointerover">
				<Setter Property="Background" Value="#FFE5E5E5"/>
			</Style>
			<Style Selector="^:selected">
				<Setter Property="Background" Value="#FFE5E5E5"/>
			</Style>
			<Style Selector="^:pressed">
				<Setter Property="Background" Value="#FFD5D5D5"/>
			</Style>

			<!-- Disabled -->
			<Style Selector="^:disabled">
				<Setter Property="Foreground" Value="#FF626262"/>
			</Style>
		</ControlTheme>
        <Bitmap x:Key="XY">avares://BazisAvaloniaGUI/Scene/Assets/xy.png</Bitmap>
        <Bitmap x:Key="ZX">avares://BazisAvaloniaGUI/Scene/Assets/zx.png</Bitmap>
        <Bitmap x:Key="ZY">avares://BazisAvaloniaGUI/Scene/Assets/zy.png</Bitmap>
        <Bitmap x:Key="rotX">avares://BazisAvaloniaGUI/Scene/Assets/rotX.png</Bitmap>
        <Bitmap x:Key="rotY">avares://BazisAvaloniaGUI/Scene/Assets/rotY.png</Bitmap>
        <Bitmap x:Key="rotZ">avares://BazisAvaloniaGUI/Scene/Assets/rotZ.png</Bitmap>
        <Bitmap x:Key="rotHor">avares://BazisAvaloniaGUI/Scene/Assets/rotHor90.png</Bitmap>
        <Bitmap x:Key="rotVer">avares://BazisAvaloniaGUI/Scene/Assets/rotVer90.png</Bitmap>
        <!-- Механизм отображения и одиночные действия — иконки WinForms-панели сцены (20x20). -->
        <Bitmap x:Key="showSidesRibs">avares://BazisAvaloniaGUI/Scene/Assets/showSidesRibs.png</Bitmap>
        <Bitmap x:Key="showRibs">avares://BazisAvaloniaGUI/Scene/Assets/showRibs.png</Bitmap>
        <Bitmap x:Key="showSides">avares://BazisAvaloniaGUI/Scene/Assets/showSides.png</Bitmap>
        <Bitmap x:Key="basis">avares://BazisAvaloniaGUI/Scene/Assets/basis.png</Bitmap>
        <Bitmap x:Key="contours">avares://BazisAvaloniaGUI/Scene/Assets/contours.png</Bitmap>
        <Bitmap x:Key="fitToScreen">avares://BazisAvaloniaGUI/Scene/Assets/fitToScreen.png</Bitmap>
        <Bitmap x:Key="screenShot">avares://BazisAvaloniaGUI/Scene/Assets/screenShot.png</Bitmap>
        <Bitmap x:Key="insideObjects">avares://BazisAvaloniaGUI/Scene/Assets/insideObjects.png</Bitmap>
        <Bitmap x:Key="advSelect">avares://BazisAvaloniaGUI/Scene/Assets/advSelect.png</Bitmap>
        <!-- Контекстное меню сцены (WinForms BaseForm.contextMenu) — иконки 16x16, как нативные
             при ImageScaling = None у пунктов меню. -->
        <Bitmap x:Key="createGroup">avares://BazisAvaloniaGUI/Scene/Assets/createGroup.png</Bitmap>
        <Bitmap x:Key="hideSelected">avares://BazisAvaloniaGUI/Scene/Assets/hideSelected.png</Bitmap>
        <Bitmap x:Key="showAllHidden">avares://BazisAvaloniaGUI/Scene/Assets/showAllHidden.png</Bitmap>
        <Bitmap x:Key="objectInfo">avares://BazisAvaloniaGUI/Scene/Assets/objectInfo.png</Bitmap>
        <Bitmap x:Key="setRotationPoint">avares://BazisAvaloniaGUI/Scene/Assets/setRotationPoint.png</Bitmap>
        <Bitmap x:Key="showAdjacent">avares://BazisAvaloniaGUI/Scene/Assets/showAdjacent.png</Bitmap>
        <Bitmap x:Key="deleteSelected">avares://BazisAvaloniaGUI/Scene/Assets/deleteSelected.png</Bitmap>
	</UserControl.Resources>

    <UserControl.Styles>
        <!-- Иконка в disabled-состоянии — 50% прозрачности (правило Button).
             Селектор-потомок нельзя размещать прямо внутри ControlTheme, поэтому стиль вынесен сюда. -->
        <Style Selector="Button:disabled Image">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="ToggleButton:disabled Image">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Стили оболочки (Styles/ShellStyles.axaml) имеют приоритет над сеттерами ControlTheme и
             перебивают размеры элементов сцены: Padding="12,8" у Button не оставляет места иконке 28x28,
             ComboBox сжимается до 20px, у MenuItem появляются фон и отступы. Локальные стили ближе
             к элементам, поэтому возвращают значения тем сцены. -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button:pointerover, Button:pressed">
            <Setter Property="Background" Value="#FFC5C5C5"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#FFF0F0F0"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="MenuItem:pointerover, MenuItem:selected">
            <Setter Property="Background" Value="#FFE5E5E5"/>
        </Style>
        <Style Selector="MenuItem:pressed">
            <Setter Property="Background" Value="#FFD5D5D5"/>
        </Style>

        <!-- Иконки кнопок панели сцены: исходники 26x26, а рабочая область кнопки 28x28 (обводка 1px)
             даёт те же 26x26 — картинка садится вплотную к рамке. Ограничиваем иконку 22x22,
             контент центрируется → визуальный отступ 2px от рамки со всех сторон.
             Stretch=Uniform сохраняет пропорции (basis 26x24, contours/showSides/insideObjects 25x26).
             Пункты контекстного меню (16x16) не затрагиваются — они не внутри Button/ToggleButton. -->
        <Style Selector="Button Image">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <Style Selector="ToggleButton Image">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <scene:SceneSurface x:Name="surface" Focusable="True">
            <!--
                Контекстное меню сцены — перенос WinForms BaseForm.contextMenu
                (Methods/Scene/MouseEvents.cs: contextMenu.Show(scene, e.Location) по правой кнопке).
                Placement у ContextMenu по умолчанию Pointer, поэтому меню раскрывается в точке клика.
                Обработчики пунктов пока не подключены.

                Порядок и тексты как в WinForms (BaseForm.resx):
                    Create a new group      — «Создать новую группу»
                    Hide selected           — «Скрыть выбранное»
                    Show all hidden         — «Показать все скрытые»
                    Selected objects        — «Выбранные объекты»
                    Set rotation point      — «Задать точку вращения»
                    Show paired             — «Показать сопряженные»
                    Remove selected         — «Удалить выбранное»
            -->
            <scene:SceneSurface.ContextMenu>
                <!-- Палитра меню — как у выпадающего списка ComboBox: фон FFFFFF, обводка 1px 7A7A7A,
                     без скруглений. Стилизация задана прямо на экземпляре: штатный шаблон
                     ContextMenu содержит Popup (PART_Popup), трогать его не нужно. -->
                <ContextMenu Background="#FFFFFFFF"
                             BorderBrush="#FF7A7A7A"
                             BorderThickness="1"
                             CornerRadius="0"
                             Padding="1"
                             WindowManagerAddShadowHint="False">
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
							  Header="{x:Static loc:SceneViewLocalization.CreateGroup}"
                              Click="OnCreateGroup">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource createGroup}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
							  Header="{x:Static loc:SceneViewLocalization.HideSelected}"
							  Click="OnHideSelected">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource hideSelected}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
							  Header="{x:Static loc:SceneViewLocalization.ShowAllHidden}"
							  Click="OnShowHidden">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource showAllHidden}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
							  Header="{x:Static loc:SceneViewLocalization.SelectedObjects}"
							  Click="OnSelectedObjects">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource objectInfo}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
							  Header="{x:Static loc:SceneViewLocalization.SetRotationPoint}"
							  Click="OnSetRotationPoint">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource setRotationPoint}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
							  Header="{x:Static loc:SceneViewLocalization.ShowPaired}"
							  Click="OnShowPaired">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource showAdjacent}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource SceneMenuItemTheme}" 
						      Header="{x:Static loc:SceneViewLocalization.RemoveSelected}"
							  Click="OnRemoveSelected">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource deleteSelected}"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </scene:SceneSurface.ContextMenu>
        </scene:SceneSurface>
        <StackPanel Spacing="4"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top">
            <!-- «Select» + кнопка дополнительного выбора — порядок и зазоры как в WinForms:
                 btnSelect (108px, «Select») → 3px → btnAdvSelection (27x27, X=114). -->
            <StackPanel Orientation="Horizontal" Spacing="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                <!-- «Select»: ComboBox со списком наборов модели — по правилу ComboBox.
                     Margin="3,3,0,0" — сдвиг на 3px от левого/верхнего края панели. -->
                <ComboBox x:Name="SetsCombo"
                          Theme="{StaticResource SceneComboBoxTheme}"
                          ItemContainerTheme="{StaticResource SceneComboBoxItemTheme}"
                          PlaceholderText="{x:Static loc:SceneViewLocalization.Select}"
                          Margin="3,3,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Width="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="scene:SetButton">
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Дополнительный выбор (btnAdvSelection в WinForms): по клику оболочка открывает окно
                     AdvanceSelection (наборы, в плоскости, по направлению; для геометрии — по объемлющим объектам). -->
                <Button Name="btnAdvSelect"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.AdvSelectToolTip}"
                        ToolTip.ShowOnDisabled="True"
                        Theme="{StaticResource SceneButtonTheme}"
                        Margin="3,3,0,0"
                        Click="OnAdvSelectClick"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Image Source="{StaticResource advSelect}"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="3"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top">
            <!-- Верхний ряд панели сцены — порядок и зазоры как в WinForms-раскладке:
                 5 кнопок механизма отображения, 9px, стрелка, 9px, «Снимок», 3px, «Вписать»,
                 3px, «Внутренние объекты», 3px, «Вид». Панель механизмов раскрывается справа налево
                 (в WinForms: кнопки X=265…412, стрелка X=421, то есть 9px до стрелки). -->
            <StackPanel Orientation="Horizontal" Spacing="0"
                        Margin="0,3,3,0"
                        HorizontalAlignment="Right">
                <!-- Механизм отображения: 5 кнопок на одной линии слева от стрелки.
                     Справа-налево: контуры, базис, стороны, рёбра, стороны+рёбра. -->
                <StackPanel x:Name="DisplayStatesPanel"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Center"
                            IsVisible="False">
                    <ToggleButton Name="btnShowSidesRibs"
                            ToolTip.Tip="{x:Static loc:SceneViewLocalization.ShowSidesRibsToolTip}"
                                  Theme="{StaticResource SceneButtonToggleTheme}"
                                  Click="OnViewModeClick">
                        <Image Source="{StaticResource showSidesRibs}"/>
                    </ToggleButton>
                    <ToggleButton Name="btnShowRibs"
                            ToolTip.Tip="{x:Static loc:SceneViewLocalization.ShowRibsToolTip}"
                                  Theme="{StaticResource SceneButtonToggleTheme}"
                                  Margin="3,0,0,0"
                                  Click="OnViewModeClick">
                        <Image Source="{StaticResource showRibs}"/>
                    </ToggleButton>
                    <ToggleButton Name="btnShowSides"
                            ToolTip.Tip="{x:Static loc:SceneViewLocalization.ShowSidesToolTip}"
                                  Theme="{StaticResource SceneButtonToggleTheme}"
                                  Margin="3,0,0,0"
                                  Click="OnViewModeClick">
                        <Image Source="{StaticResource showSides}"/>
                    </ToggleButton>
                    <!-- Базис виден по умолчанию: SceneRenderSettings.DisplayBasis = true. -->
                    <ToggleButton Name="btnBazis"
                            ToolTip.Tip="{x:Static loc:SceneViewLocalization.BasisToolTip}"
                                  Theme="{StaticResource SceneButtonToggleTheme}"
                                  IsChecked="True"
                                  Margin="3,0,0,0"
                                  Click="OnBasisClick">
                        <Image Source="{StaticResource basis}"/>
                    </ToggleButton>
                    <!-- Ближайшая к стрелке кнопка — контуры (9px задаёт Margin у стрелки). -->
                    <ToggleButton Name="btnContours"
                            ToolTip.Tip="{x:Static loc:SceneViewLocalization.ContoursToolTip}"
                                  Theme="{StaticResource SceneButtonToggleTheme}"
                                  Margin="3,0,0,0"
                                  Click="OnContoursClick">
                        <Image Source="{StaticResource contours}"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Стрелка раскрытия механизмов отображения: без подписи, вниз → влево при раскрытии;
                     9px до ближайшей кнопки панели. -->
                <ToggleButton x:Name="DisplayStatesToggle"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.DisplayStatesToolTip}"
                              Theme="{StaticResource SceneDropdownToggleTheme}"
                              Classes="ArrowLeft ArrowCenter"
                              Width="20"
                              Padding="0"
                              Margin="9,0,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>
                <!-- «Снимок экрана» (9px от стрелки) -->
                <Button Name="btnMakeScreenShot"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.ScreenShotToolTip}"
                        Theme="{StaticResource SceneButtonTheme}"
                        Margin="9,0,0,0"
                        Click="OnMakeScreenShotClick">
                    <Image Source="{StaticResource screenShot}"/>
                </Button>

                <!-- «Вписать в экран» -->
                <Button Name="btnFitToScreen"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.FitToScreenToolTip}"
                        Theme="{StaticResource SceneButtonTheme}"
                        Margin="3,0,0,0"
                        Click="OnFitToScreenClick">
                    <Image Source="{StaticResource fitToScreen}"/>
                </Button>
                
                <!-- «Внутренние объекты» -->
                <Button Name="btnShowInsideObjects"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.InsideObjectsToolTip}"
                        Theme="{StaticResource SceneButtonTheme}"
                        Margin="3,0,0,0"
                        Click="OnShowInsideObjectsClick">
                    <Image Source="{StaticResource insideObjects}"/>
                </Button>

                <!-- «View»: кнопка-переключатель раскрытия панели видов — по правилу ComboBox. -->
                <ToggleButton x:Name="ViewToggle"
                              Theme="{StaticResource SceneDropdownToggleTheme}"
                              Margin="3,0,0,0"
                              Content="{x:Static loc:SceneViewLocalization.View}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Width="120"/>
            </StackPanel>

            <Canvas x:Name="ViewButtonsPanel"
                        IsVisible="False"
                        Height="245">
                <!-- Иконки 20x20: высоту держим в пределах стандартных ~32px (Padding по вертикали не задаём). -->
                <Button Name="btnXY"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.PlaneXYToolTip}"
                        Theme="{StaticResource SceneButtonTheme}"
                        Canvas.Right="3"
                        Canvas.Top="0"
                        Click="OnViewChangeClick">
                    <Image Source="{StaticResource XY}"/>
                </Button>
                <Button Name="btnZX"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.PlaneZXToolTip}"
                        Theme="{StaticResource SceneButtonTheme}"
                        Canvas.Right="3"
                        Canvas.Top="31"
                        Click="OnViewChangeClick">
                    <Image Source="{StaticResource ZX}"/>
                </Button>
                <Button Name="btnZY"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.PlaneZYToolTip}"
                        Theme="{StaticResource SceneButtonTheme}"
                        Canvas.Right="3"
                        Canvas.Top="62"
                        Click="OnViewChangeClick">
                    <Image Source="{StaticResource ZY}"/>
                </Button>
                <ToggleButton Name="btnRotX"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.RotateXToolTip}"
                              Theme="{StaticResource SceneButtonToggleTheme}"
                              Canvas.Right="3"
                              Canvas.Top="93"
                              Click="OnRotateChangeModeClick">
                    <Image Source="{StaticResource rotX}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotY"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.RotateYToolTip}"
                              Theme="{StaticResource SceneButtonToggleTheme}"
                              Canvas.Right="3"
                              Canvas.Top="124"
                              Click="OnRotateChangeModeClick">
                    <Image Source="{StaticResource rotY}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotZ"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.RotateZToolTip}"
                              Theme="{StaticResource SceneButtonToggleTheme}"
                              Canvas.Right="3"
                              Canvas.Top="155"
                              Click="OnRotateChangeModeClick">
                    <Image Source="{StaticResource rotZ}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotHor"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.RotateHorizontal90ToolTip}"
                              Theme="{StaticResource SceneButtonToggleTheme}"
                              Canvas.Right="3"
                              Canvas.Top="186"
                              Click="OnRotateByRightAngle">
                    <Image Source="{StaticResource rotHor}"/>
                </ToggleButton>
                <ToggleButton Name="btnRotVer"
                        ToolTip.Tip="{x:Static loc:SceneViewLocalization.RotateVertical90ToolTip}"
                              Theme="{StaticResource SceneButtonToggleTheme}"
                              Canvas.Right="3"
                              Canvas.Top="217"
                              Click="OnRotateByRightAngle">
                    <Image Source="{StaticResource rotVer}"/>
                </ToggleButton>
            </Canvas>
        </StackPanel>
    </Panel>
</UserControl>
