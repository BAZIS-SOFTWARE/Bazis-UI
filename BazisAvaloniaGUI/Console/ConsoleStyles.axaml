<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Крестик PinnedPage в заголовке консоли: рисуется без фона и рамки. -->
  <Style Selector="Button.console-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.console-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.console-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.console-close:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- LinkLabel: синий подчёркнутый путь журнала сессии. -->
  <Style Selector="Button.console-log">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#0000FF" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.console-log:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#0000FF" />
  </Style>
  <Style Selector="Button.console-log:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#FF0000" />
  </Style>
  <Style Selector="Button.console-log:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- ToolStripEx: ItemBackGroundColor #E4E4E4, FrameColor DarkGray, ItemSelectColor Gray, ItemPressColor Black (2 px). -->
  <Style Selector="Button.console-action">
    <Setter Property="Width" Value="23" />
    <Setter Property="Height" Value="23" />
    <Setter Property="Margin" Value="4,3,4,3" />
    <Setter Property="Padding" Value="1,1,0,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="#E4E4E4" />
    <Setter Property="BorderBrush" Value="#A9A9A9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.console-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#808080" />
    <Setter Property="BorderBrush" Value="#A9A9A9" />
  </Style>
  <Style Selector="Button.console-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#808080" />
    <Setter Property="BorderBrush" Value="#000000" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.console-action:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Последняя строка RichTextBox: ввод без рамки и фона, шрифт поля (Microsoft Sans Serif 8.25 pt). -->
  <Style Selector="TextBox.console-input">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontFamily" Value="Microsoft Sans Serif" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="CaretBrush" Value="#000000" />
  </Style>
  <Style Selector="TextBox.console-input /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TextBox.console-input:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.console-input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.console-input:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.console-input:pointerover, TextBox.console-input:focus">
    <Setter Property="Foreground" Value="#000000" />
  </Style>
</Styles>
