@startuml
title BazisGUI.Avalonia-4 — запросы данных и действия навигатора
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.Avalonia. Навигатор" {
  class "NavigatorControl (продолжение)" as NavigatorControl {
    + {event} GetSetsInfoEvent
    + {event} GetObjectsInfoEvent
    + {event} GetObjectInfoEvent
    + {event} GetResultInfoEvent
    + {event} DelSetEvent
    + {event} DelGroupEvent
    + {event} DelObjectEvent
    + {event} DelCondEvent
    + {event} HideResultsEvent
    + {event} RemoveResultsEvent
    + {event} RemoveAllConditionsEvent
    + {event} DelAllGroupsEvent
    + {event} ShowAllGroupsEvent
    + {event} HideAllGroupsEvent
    + {event} ChangeAllGeoViewStateEvent
    + {event} DelAllGeoEvent
    + {event} DelAllMeshEvent
    + {event} ChangeAllMeshViewStateEvent
    + {event} ShowSetEvent
    + {event} HideSetEvent
    + {event} HideGroupEvent
    + {event} ShowGroupEvent
    + {event} EditGroupEvent
    + {event} InfoGroupEvent
    + {event} ShowObjectEvent
    + {event} HideObjectEvent
  }
}
package "BazisGUI.Avalonia. Оболочка" {
  class "MainWindow (обработчики Navigator)" as MainWindow
}
NavigatorControl --> MainWindow : события
note bottom of NavigatorControl
  [[BazisGUI.Avalonia-2.mdpuml Выбор объектов BazisGUI.Avalonia-2]]
  [[BazisGUI.Avalonia.mdpuml Назад к BazisGUI.Avalonia]]
end note
@enduml
