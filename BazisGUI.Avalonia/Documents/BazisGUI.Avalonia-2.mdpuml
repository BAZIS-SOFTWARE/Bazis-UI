@startuml
title BazisGUI.Avalonia-2 — навигатор проекта
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.Avalonia. Навигатор" {
  class NavigatorControl {
    - ConfigureTreeView() : void
    + SelectNode(node) : void
    + CreateRealNode(name) : TreeNode
    + CreateVirtualNode(name) : TreeNode
    + ActionMenu(node, index) : void
    + TrySearchNodes(name, nodes) : bool
    + BeginUpdate() : void
    + EndUpdate() : void
    + {event} SelectSetEvent
    + {event} SelectGroupEvent
    + {event} SelectObjectEvent
    + {event} SelectCondEvent
    + {event} SelectTaskEvent
    + {event} SelectGeoEvent
    + {event} SelectMeshEvent
    + {event} SelectResultsEvent
    + {event} SelectCompEvent
    + {event} SelectCompsEvent
    + {event} SelectGeneralInfoEvent
    + {event} SelectTimeEvent
    + {event} SelectResultEvent
  }
  class TreeNode {
    + Name : string
    + Text : string
    + Nodes : TreeNodeCollection
    + Expand() : void
    + Collapse() : void
    + Remove() : void
  }
  class TreeNodeCollection {
    + Add(node) : int
    + AddRange(nodes) : void
    + Clear() : void
    + Find(key, searchAllChildren) : TreeNode[]
  }
  class NavigatorRow {
    - UpdateView() : void
    - UpdateActions() : void
    - CreateActionIcon(imageIndex, position) : Image
  }
}
package "BazisGUI.Avalonia. Оболочка" {
  class "MainWindow (обработчики Navigator)" as MainWindow
}

NavigatorControl --> TreeNode
NavigatorControl *-- NavigatorRow : шаблон строки AXAML
NavigatorRow --> TreeNode : отображает
TreeNode *-- TreeNodeCollection
NavigatorControl --> MainWindow : пользовательские действия
MainWindow --> NavigatorControl : обновление дерева

note bottom of NavigatorControl
  События объявлены в NavigatorControl.cs.
  [[BazisGUI.Avalonia.mdpuml Назад к BazisGUI.Avalonia]]
  [[BazisGUI.Avalonia-4.mdpuml Действия навигатора BazisGUI.Avalonia-4]]
  [[BazisGUI.Avalonia-3.mdpuml Панели BazisGUI.Avalonia-3]]
end note
@enduml
