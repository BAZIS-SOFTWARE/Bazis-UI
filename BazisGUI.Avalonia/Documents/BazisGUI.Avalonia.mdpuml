@startuml
title BazisGUI.Avalonia — состав проекта и точки входа
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.Avalonia. Оболочка" {
  class MainWindow <<BazisGUI.Avalonia-1..4>> {
    + HandleArgs(args) : void
    - OpenProject(path) : Task<bool>
    - SaveProjectAsync(saveAs) : Task<bool>
    - PresentProject() : void
    + {event} OnProjectLoaded
    + {event} OnGroupCreated
    + {event} OnGroupRenamed
    + {event} OnGroupDeleted
    + {event} OnChangeMaterials
    + {event} OnChangeFunctions
  }
}
package "BazisGUI.Avalonia. Сцена" {
  class SceneView <<BazisGUI.Avalonia-1>> {
    + Surface : SceneSurface
    + UpdateSets(project) : void
  }
  class SceneSurface <<BazisGUI.Avalonia-1>> {
    + ShowProject(project) : void
    + Redraw() : void
  }
}
package "BazisGUI.Avalonia. Панели" {
  class NavigatorControl <<BazisGUI.Avalonia-2, BazisGUI.Avalonia-4>>
  class PropertiesPanelControl <<BazisGUI.Avalonia-3>>
  class ConsoleControl <<BazisGUI.Avalonia-3>>
  class PlayerControl <<BazisGUI.Avalonia-3>>
}
package "BazisGUI.Avalonia. Данные" {
  class IODataController {
    + LoadConfig() : SettingsConfig
    + OpenProject(path) : Task<ProjectController>
    + ImportMesh(path) : Task<ProjectController>
    + ExportMesh(project) : Task<string>
  }
  class SettingsConfig
}
package "BazisGUI.Avalonia. Локализация" {
  class Localization <<BazisGUI.Avalonia-5>> {
    + GetFormText(name) : string
  }
}
package "OperationalController. Проект" {
  class ProjectController <<внешний>>
}

MainWindow --> SceneView
SceneView *-- SceneSurface
MainWindow --> NavigatorControl
MainWindow --> PropertiesPanelControl
MainWindow --> ConsoleControl
MainWindow --> PlayerControl
MainWindow --> IODataController
MainWindow --> ProjectController
IODataController --> SettingsConfig
IODataController --> ProjectController

note bottom of MainWindow
  Сцена: [[BazisGUI.Avalonia-1.mdpuml BazisGUI.Avalonia-1]]
  Навигатор: [[BazisGUI.Avalonia-2.mdpuml BazisGUI.Avalonia-2]]
  Свойства, консоль и плеер: [[BazisGUI.Avalonia-3.mdpuml BazisGUI.Avalonia-3]]
  Действия навигатора: [[BazisGUI.Avalonia-4.mdpuml BazisGUI.Avalonia-4]]
  Локализация: [[BazisGUI.Avalonia-5.mdpuml BazisGUI.Avalonia-5]]
end note
note bottom of ProjectController
  Внешний проект: показана только точка входа.
end note
@enduml
