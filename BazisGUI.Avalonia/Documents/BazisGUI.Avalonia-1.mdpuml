@startuml
title BazisGUI.Avalonia-1 — сцена и представление проекта
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.Avalonia. Сцена" {
  class "MainWindow (подключение сцены)" as SceneConnection {
    + DisplayText3D(text: string, color: Color, coord: Point3D) : void
    + DisplayText2D(text: string, color: Color, coord: Point2D) : void
    + DisplayDistance(line: Segment3D) : void
    + DisplayPath(points: Point3D[]) : void
    + DisplayVector(length: Point3D, position: Point3D, color: Color) : void
    + DisplaySpiral(p0: Point3D, p1: Point3D, color: Color) : void
    + DisplayClipPlane(plane: ModelPlane3D) : void
    + DisplayLocalFrame(frame: ModelFrame3D) : void
    + DisplayConus(upperDiam: float, bottomDiam: float, length: float, frame: ModelFrame3D) : void
    + DisplaySphere(width: float, frame: ModelFrame3D) : void
  }
  class SceneView {
    + Surface : SceneSurface
    + UpdateSets(project, resetSelection) : void
    + {event} ScreenShotRequested
    + {event} AdvancedSelectionRequested
  }
  class SceneSurface {
    + Invoke(action) : void
    + InvokeAsync(func) : Task<T>
    + CaptureFrameAsync() : Task<byte[]>
    + Redraw() : void
    + ShowProject(project) : void
    + RefreshSets(sets) : void
    + SetViewMode(mode) : void
    + ClearSelection() : void
    - SetRotationPoint() : void
    + {event} ProjectShown
    + {event} ProjectDisplayFailed
    + {event} SelectionApplied
    + {event} SelectionReset
    + {event} GroupCreated
    + {event} ObjectsRemoved
    + {event} MessageReported
    + {event} ControllerRecreated
    + {event} SelectedObjectTypeChanged
  }
  class SceneProjectPresenter {
    + Display(project, scene, fitToScreen) : void
    + Refresh(project, scene, sets) : void
    + RefreshShown(project, scene, sets) : void
    + Recolor(project, scene, sets) : void
    + DeleteAll(scene) : void
  }
  class SceneSelection {
    + Apply(project, scene, selectedType, selection) : SceneSelectionResult
    - GetVisibleObjects(sourceSet, project, elementByNumber) : IEnumerable<ScenePickObject>
    - GetCadSurfacePoints(number: int, project) : IEnumerable<Point3D>
    - GetElementSurfacePoints(element: ISurfaceElement, project) : IEnumerable<Point3D>
  }
  class SceneSelectionResult <<record>>
}
package "BazisGUI.SceneCore. Сцена" {
  class SceneController <<внешний>>
}
package "BazisGUI.SceneCore. Выбор" {
  class ScenePickObject <<внешний>>
}
package "BazisGUI.SceneCore. Координаты" {
  class ModelPoint3D <<внешний>>
  class ModelVector3D <<внешний>>
  class ModelPlane3D <<внешний>>
  class ModelFrame3D <<внешний>>
  class CameraPoint3D <<внешний>>
  class ViewportPoint <<внешний>>
}
package "OperationalController. Проект" {
  class IProjectController <<внешний>>
}
package "Model. Поверхностные элементы" {
  interface ISurfaceElement <<внешний>>
}
package "Geometry. Координаты" {
  class Point3D <<внешний>>
  class Point2D <<внешний>>
  class Segment3D <<внешний>>
}

SceneView *-- SceneSurface
SceneSurface *-- SceneProjectPresenter
SceneSurface *-- SceneSelection
SceneSelection --> SceneSelectionResult
SceneSurface --> SceneController
SceneSurface --> ModelPoint3D : точка модели для камеры
SceneConnection --> SceneController : передача геометрии сцены
SceneConnection --> ModelPlane3D
SceneConnection --> ModelFrame3D
SceneConnection --> ModelPoint3D : точки для SceneCore
SceneConnection --> ModelVector3D : направление вектора
SceneConnection --> Segment3D : входной отрезок
SceneConnection --> Point3D : преобразует координаты текста
SceneConnection --> Point2D : преобразует координаты текста
SceneSurface --> CameraPoint3D : глубина выбора
SceneProjectPresenter --> SceneController
SceneSelection --> SceneController
SceneSelection --> ScenePickObject : точки ModelPoint3D
SceneSelection --> ViewportPoint : выбор точкой
SceneProjectPresenter --> IProjectController
SceneSelection --> IProjectController
SceneSelection --> ISurfaceElement : триангуляция граней
SceneSelection --> Point3D : входные координаты

note bottom of SceneSurface
  Действия над GL передаются в очередь Invoke
  и выполняются во время OnOpenGlRender.
  Глубина выбора вычисляется как double;
  входные данные VBO остаются float.
  [[BazisGUI.Avalonia.mdpuml Назад к BazisGUI.Avalonia]]
end note
@enduml
