<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BazisGUI.Avalonia.Navigator.NavigatorControl"
             Background="#F0F0F0">
  <ListBox x:Name="treeView" Classes="navigator-tree" Background="#F0F0F0"
           FontFamily="Microsoft Sans Serif" FontSize="10.6667"
           SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
</UserControl>
