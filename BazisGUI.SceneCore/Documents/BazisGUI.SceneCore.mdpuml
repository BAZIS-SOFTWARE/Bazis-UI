@startuml
title BazisGUI.SceneCore — координаты сцены и граница рендера
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.SceneCore. Камера" {
  class SceneCamera <<BazisGUI.SceneCore-1>>
  class GlMatrix <<BazisGUI.SceneCore-1>>
}
package "BazisGUI.SceneCore. Геометрия" {
  class BoundingBox <<BazisGUI.SceneCore-2>>
  class ScenePath <<BazisGUI.SceneCore-2>>
}
package "BazisGUI.SceneCore. Выбор" {
  class ScenePicker <<BazisGUI.SceneCore-2>>
  class RectangleBox <<BazisGUI.SceneCore-2>> [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]]
  class Set <<BazisGUI.SceneCore-2>> [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]]
  class ScenePickObject <<BazisGUI.SceneCore-2>> [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]]
  class ViewportTriangle <<BazisGUI.SceneCore-2>> [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]]
}
package "BazisGUI.SceneCore. Координаты" {
  class ModelPoint3D <<BazisGUI.SceneCore-1>> [[BazisGUI.SceneCore-1.mdpuml BazisGUI.SceneCore-1]]
  class CameraPoint3D <<BazisGUI.SceneCore-1>> [[BazisGUI.SceneCore-1.mdpuml BazisGUI.SceneCore-1]]
  class ModelVector3D <<BazisGUI.SceneCore-1>> [[BazisGUI.SceneCore-1.mdpuml BazisGUI.SceneCore-1]]
  class ModelPlane3D <<BazisGUI.SceneCore-1>> [[BazisGUI.SceneCore-1.mdpuml BazisGUI.SceneCore-1]]
  class ModelFrame3D <<BazisGUI.SceneCore-1>> [[BazisGUI.SceneCore-1.mdpuml BazisGUI.SceneCore-1]]
  class ViewportPoint <<BazisGUI.SceneCore-2>> [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]]
}
package "BazisGUI.SceneCore. Буферы" {
  class ClipPlane <<BazisGUI.SceneCore-2>>
  class QuadricMeshFactory <<BazisGUI.SceneCore-2>>
}
package "BazisGUI.SceneCore. Текст" {
  class TextLayer <<BazisGUI.SceneCore-3>> [[BazisGUI.SceneCore-3.mdpuml BazisGUI.SceneCore-3]]
  class TextLabel2D <<BazisGUI.SceneCore-3>> [[BazisGUI.SceneCore-3.mdpuml BazisGUI.SceneCore-3]]
  class TextLabel3D <<BazisGUI.SceneCore-3>> [[BazisGUI.SceneCore-3.mdpuml BazisGUI.SceneCore-3]]
}
package "Geometry. Координаты" {
  class Point3D <<внешний>>
}

SceneCamera --> GlMatrix
SceneCamera --> ModelPoint3D
SceneCamera --> CameraPoint3D
SceneCamera --> ModelVector3D
ModelPlane3D --> ModelVector3D
ModelFrame3D --> ModelPoint3D
ModelFrame3D --> ModelVector3D
ScenePicker --> SceneCamera
ScenePicker --> Set
Set --> ScenePickObject
ScenePickObject --> ModelPoint3D
ScenePicker --> RectangleBox
ScenePicker --> ViewportTriangle
RectangleBox --> ViewportPoint
ScenePath --> ModelPoint3D
BoundingBox --> Point3D
ClipPlane --> BoundingBox
QuadricMeshFactory --> Point3D
TextLayer --> TextLabel2D
TextLayer --> TextLabel3D

note bottom of SceneCamera
  Камера и преобразования: [[BazisGUI.SceneCore-1.mdpuml BazisGUI.SceneCore-1]].
end note
note bottom of BoundingBox
  Геометрия, выбор и буферы: [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]].
end note
note bottom of Point3D
  Внешняя геометрия BazisCore: мировые координаты double.
end note
@enduml
