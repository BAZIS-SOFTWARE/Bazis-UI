@startuml
title BazisGUI.SceneCore-1 — камера и преобразования
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "BazisGUI.SceneCore. Контракты" {
  interface ISceneCamera {
    + Width : int [get, set]
    + Height : int [get, set]
    + AngleOfProjection : float [get, set]
    + Position : ModelPoint3D [get, set]
    + SetViewMatrix(matrix: Matrix<float>) : void
    + GetViewMatrix() : Matrix<float>
    + GetSceneVectorOfScreenVector(x: float, y: float) : ModelVector3D
    + Move(newMousePosition, mousePosition, scaleFactor) : void
    + GetSceneCoord(point: ModelPoint3D) : CameraPoint3D
    + GetSceneVector(deltaX: int, deltaY: int, depth: float, scaleFactor: float) : ModelVector3D
    + GetScreenCoord(coord: CameraPoint3D) : ViewportPoint
    + Rotate(axis: ViewAxis, angle: float) : void
    + Rotate(dx: float, dy: float, axis: ViewAxis, angle: float) : void
    + SetOnPlane(plane: ViewPlane, scaleFactor: float) : void
  }
}
package "BazisGUI.SceneCore. Камера" {
  class SceneCamera {
    + ScaleFactor : float [get]
    + Initialize(moveX: float, moveY: float, moveZ: float) : void
    + GetProjectionMatrix() : Matrix<float>
    + Scale(scaleFactor: float) : void
    + SetRotationCentre(modelPoint: ModelPoint3D) : void
    + ResetPan() : void
  }
  class GlMatrix <<static>> {
    + Identity() : Matrix<float>
    + Translate(m: Matrix<float>, x: double, y: double, z: double) : Matrix<float>
    + Scale(m: Matrix<float>, x: float, y: float, z: float) : Matrix<float>
    + Rotate(m: Matrix<float>, angle: float, x: double, y: double, z: double) : Matrix<float>
    + RotationMatrix(angle: float, x: float, y: float, z: float) : Matrix<float>
  }
}
package "BazisGUI.SceneCore. Координаты" {
  class ModelPoint3D <<readonly struct>> {
    + X : double [get]
    + Y : double [get]
    + Z : double [get]
    + ModelPoint3D(x: double, y: double, z: double)
  }
  class CameraPoint3D <<readonly struct>> {
    + X : double [get]
    + Y : double [get]
    + Z : double [get]
    + CameraPoint3D(x: double, y: double, z: double)
  }
  class ModelVector3D <<readonly struct>> {
    + X : double [get]
    + Y : double [get]
    + Z : double [get]
    + ModelVector3D(x: double, y: double, z: double)
  }
  class ModelPlane3D {
    + Normal : ModelVector3D [get]
    + D : double [get]
    + ModelPlane3D(normal: ModelVector3D, d: double)
  }
  class ModelFrame3D {
    + Centre : ModelPoint3D [get]
    + DirectionX : ModelVector3D [get]
    + DirectionY : ModelVector3D [get]
    + DirectionZ : ModelVector3D [get]
    + ModelFrame3D(centre: ModelPoint3D, directionX: ModelVector3D, directionY: ModelVector3D, directionZ: ModelVector3D)
  }
  class "ViewportPoint\nSceneCore-2" as ViewportPoint <<ссылка>> [[BazisGUI.SceneCore-2.mdpuml BazisGUI.SceneCore-2]]
}

SceneCamera ..|> ISceneCamera
SceneCamera --> GlMatrix
SceneCamera --> ModelPoint3D
ISceneCamera --> ModelPoint3D
ISceneCamera --> CameraPoint3D
ISceneCamera --> ModelVector3D
ISceneCamera --> ViewportPoint
ModelPlane3D --> ModelVector3D
ModelFrame3D --> ModelPoint3D
ModelFrame3D --> ModelVector3D

note bottom of GlMatrix
  Матрицы хранятся с элементами float.
  Точки и направления преобразует SceneCamera.
  [[BazisGUI.SceneCore.mdpuml Назад к BazisGUI.SceneCore]]
  [[BazisGUI.SceneCore-2.mdpuml Геометрия и буферы]]
end note
@enduml
