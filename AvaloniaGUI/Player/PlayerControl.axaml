<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaGUI.Player.PlayerControl"
             MinHeight="35">
  <Border BorderBrush="Gray" BorderThickness="1">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="2">
      <Button x:Name="btnCheckDinamic" Width="31" Height="31" Padding="2">
        <Image x:Name="checkImage" Width="20" Height="20"/>
      </Button>
      <Button x:Name="btnStopCheck" Grid.Column="1" Width="31" Height="31" Padding="2">
        <Image x:Name="stopImage" Width="20" Height="20"/>
      </Button>
      <Slider x:Name="colorSlider" Grid.Column="2" Minimum="0" Maximum="100"
              SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
              TickFrequency="1" VerticalAlignment="Center" Margin="4,0"/>
      <TextBlock x:Name="valueText" Grid.Column="3" VerticalAlignment="Center"
                 MinWidth="24" Foreground="Black"/>
    </Grid>
  </Border>
</UserControl>
