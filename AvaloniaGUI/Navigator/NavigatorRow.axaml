<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="AvaloniaGUI.Navigator.NavigatorRow"
      Height="18" Background="Transparent" ColumnDefinitions="Auto,Auto,*,Auto">
  <Border x:Name="expander" Width="16" Height="18" Background="Transparent" Cursor="Hand">
    <Path x:Name="glyph" Stroke="#606060" StrokeThickness="1.2"
          HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <Image x:Name="image" Grid.Column="1" Width="16" Height="16" Margin="0,0,4,0"
         VerticalAlignment="Center"/>
  <TextBlock x:Name="text" Grid.Column="2" VerticalAlignment="Center"
             TextTrimming="CharacterEllipsis" Foreground="Black"/>
  <StackPanel x:Name="actions" Grid.Column="3" Orientation="Horizontal"
              VerticalAlignment="Center" Margin="4,0,4,0"/>
</Grid>
