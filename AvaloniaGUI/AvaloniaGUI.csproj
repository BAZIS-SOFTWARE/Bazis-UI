<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BazisCoreSource>$(MSBuildThisFileDirectory)..\..\BazisComponents\BazisCore\OperationalController\OperationalController.csproj</BazisCoreSource>
    <UseBazisCoreSource Condition="'$(UseBazisCoreSource)' == '' and Exists('$(BazisCoreSource)')">true</UseBazisCoreSource>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\WinGUI\IconShort_32.ico</ApplicationIcon>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
    <Version>6.0.5</Version>
  </PropertyGroup>

  <!-- Если выбран профиль запуска через WSL -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug-Linux'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <OutputPath>bin/Linux/Debug/</OutputPath>
  </PropertyGroup>

  <!-- Если выбран профиль запуска через WSL -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-Linux'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <OutputPath>bin/Linux/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OperationalController" Version="4.11.3" />
    <PackageReference Include="PostProc" Version="2.3.1" />
    <PackageReference Include="PreProc" Version="2.7.1" Condition="'$(UseBazisCoreSource)' != 'true'" />
    <PackageReference Include="ClientLogicCP" Version="1.1.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PreProc" Version="2.7.5" />
    <PackageReference Include="PropertiesCalculator" Version="1.1.2" />
    <Reference Include="LicenseInfo">
      <HintPath>..\Libs\LicenseInfo.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SceneCore\SceneCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\WinGUI\IconShort_32.ico" Link="Assets\IconShort_32.ico" />
    <AvaloniaResource Include="Navigator\Assets\*.png" />
    <AvaloniaResource Include="Databases\Assets\*.png" />
    <AvaloniaResource Include="Console\Assets\*.png" />
    <AvaloniaResource Include="Chamfer\Assets\*.png" />
    <AvaloniaResource Include="Scene\Assets\*.png" />
    <AvaloniaResource Include="Player\Assets\*.png" />
    <Content Include="..\WinGUI\DataBases\Materials\materials_draft.txt" Link="DataBases\Materials\materials_draft.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\WinGUI\DataBases\Functions\functions_draft.txt" Link="DataBases\Functions\functions_draft.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\WinGUI\DataBases\Materials\Materials_v4.jsf" Link="DataBases\Materials\Materials_v4.jsf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\WinGUI\DataBases\Materials\Materials_v6.jsf" Link="DataBases\Materials\Materials_v6.jsf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\WinGUI\DataBases\Functions\functions.jsf" Link="DataBases\Functions\functions.jsf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\WinGUI\Help\ПО Bazis 5.2. Руководство пользователя.pdf" Link="Help\ПО Bazis 5.2. Руководство пользователя.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
