@startuml
title AvaloniaGUI — состав проекта и точки входа
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "AvaloniaGUI. Оболочка" {
  class MainWindow <<AvaloniaGUI-1..4>> {
    + HandleArgs(args) : void
    - OpenProject(path) : Task<bool>
    - SaveProjectAsync(saveAs) : Task<bool>
    - PresentProject() : void
    + {event} OnProjectLoaded
    + {event} OnGroupCreated
    + {event} OnGroupRenamed
    + {event} OnGroupDeleted
    + {event} OnChangeMaterials
    + {event} OnChangeFunctions
  }
}
package "AvaloniaGUI. Сцена" {
  class SceneView <<AvaloniaGUI-1>> {
    + Surface : SceneSurface
    + UpdateSets(project) : void
  }
  class SceneSurface <<AvaloniaGUI-1>> {
    + ShowProject(project) : void
    + Redraw() : void
  }
}
package "AvaloniaGUI. Панели" {
  class NavigatorControl <<AvaloniaGUI-2, AvaloniaGUI-4>>
  class PropertiesPanelControl <<AvaloniaGUI-3>>
  class ConsoleControl <<AvaloniaGUI-3>>
  class PlayerControl <<AvaloniaGUI-3>>
}
package "AvaloniaGUI. Данные" {
  class IODataController {
    + LoadConfig() : SettingsConfig
    + OpenProject(path) : Task<ProjectController>
    + ImportMesh(path) : Task<ProjectController>
    + ExportMesh(project) : Task<string>
  }
  class SettingsConfig
}
package "AvaloniaGUI. Локализация" {
  class Localization <<AvaloniaGUI-5>> {
    + GetFormText(name) : string
  }
}
package "OperationalController. Проект" {
  class ProjectController <<внешний>>
}

MainWindow --> SceneView
SceneView *-- SceneSurface
MainWindow --> NavigatorControl
MainWindow --> PropertiesPanelControl
MainWindow --> ConsoleControl
MainWindow --> PlayerControl
MainWindow --> IODataController
MainWindow --> ProjectController
IODataController --> SettingsConfig
IODataController --> ProjectController

note bottom of MainWindow
  Сцена: [[AvaloniaGUI-1.mdpuml AvaloniaGUI-1]]
  Навигатор: [[AvaloniaGUI-2.mdpuml AvaloniaGUI-2]]
  Свойства, консоль и плеер: [[AvaloniaGUI-3.mdpuml AvaloniaGUI-3]]
  Действия навигатора: [[AvaloniaGUI-4.mdpuml AvaloniaGUI-4]]
  Локализация: [[AvaloniaGUI-5.mdpuml AvaloniaGUI-5]]
end note
note bottom of ProjectController
  Внешний проект: показана только точка входа.
end note
@enduml
