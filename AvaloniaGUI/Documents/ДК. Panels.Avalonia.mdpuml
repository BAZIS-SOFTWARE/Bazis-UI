@startuml

title BazisAvaloniaGUI — панели оболочки: навигатор, панель свойств, консоль\nПлан переноса из BazisGUI. Окно и меню — ДК. MainWindow.Avalonia, сцена и сеанс — ДК. Scene.Avalonia.Detail

hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 26
skinparam ranksep 42
set namespaceSeparator none

legend top left
  <<planned>>  — предлагается, пока не реализовано
  <<reuse>>    — переносится из BazisGUI почти без изменений
  <<boundary>> — описан на другой диаграмме, здесь показан свёрнуто
end legend

' =====================================================================
package "BazisAvaloniaGUI. MainWindow" {
  class MainWindowViewModel <<boundary>>
  class PlayerViewModel <<boundary>>
}

' =====================================================================
package "BazisAvaloniaGUI. Navigator" {
  class NavigatorViewModel <<planned>> {
    + Roots : IEnumerable<NavigatorNode>
    + SelectedNode : NavigatorNode
    - OnSelectedNodeChanged() : void
    - Rebuild() : void
  }
  class NavigatorTreeBuilder <<planned>> {
    + Build(project : IProjectController) : IEnumerable<NavigatorNode>
  }
  abstract class NavigatorNode <<planned>> {
    + Header : string
    + Children : IEnumerable<NavigatorNode>
    + LoadChildren() : void
    + CreatePropertySource() : IPropertySource
    + CreatePlayback() : ICondPlayback
    + GetActions() : IEnumerable<NodeAction>
  }
  class NodeAction <<planned>> {
    + Header : string
    + Command : IRelayCommand
  }
  class SetNode <<planned>> {
    - set : ISetInfo
  }
  class ObjectNode <<planned>> {
    - objType : ObjType
    - number : int
  }
  class CondNode <<planned>> {
    - data : ICondData
  }
  class TaskNode <<planned>>
}

' =====================================================================
package "BazisAvaloniaGUI. PropertiesPanel" {
  class PropertiesPanelViewModel <<planned>> {
    + Title : string
    + Rows : IEnumerable<PropertyRow>
    + Apply(row : PropertyRow, value : string) : void
  }
  class ActiveItem <<planned>> {
    + Source : IPropertySource
    + {event} Changed : EventHandler
    + Set(source : IPropertySource) : void
    + Clear() : void
  }
  interface IPropertySource <<planned>> {
    + Title : string
    + {event} RowsChanged : EventHandler
    + GetRows() : IEnumerable<PropertyRow>
    + Validate(row : PropertyRow, value : string) : PropertyValidation
    + Apply(row : PropertyRow, value : string) : void
  }
  class PropertyValidation <<planned>> {
    + IsValid : bool
    + Corrected : string
    + Message : string
  }
  class PropertyRow <<planned>> {
    + Key : string
    + Header : string
    + IsReadOnly : bool
    + Value : PropertyValue
  }
  abstract class PropertyValue <<planned>>
  class TextValue <<planned>>
  class NumberValue <<planned>>
  class FlagValue <<planned>>
  class ChoiceValue <<planned>>
  class ActionValue <<planned>>
  class HeaderValue <<planned>>

  class EmptyPropertySource <<planned>>
  class SetPropertySource <<planned>>
  class CondPropertySource <<planned>>
  class SceneSelectionPropertySource <<planned>>
}

' =====================================================================
package "BazisAvaloniaGUI. Console" {
  class ConsoleViewModel <<planned>> {
    + Entries : IEnumerable<LogEntry>
    + Input : string
    + Execute : IAsyncRelayCommand
    + ShowCommands : IRelayCommand
  }
  class ConsoleCommandRunner <<planned>> {
    + ExecuteAsync(line : string) : Task
  }
  class ConsoleCommandRegistry <<planned>> {
    + Register(command : IConsoleCommand) : void
    + Find(name : string) : IConsoleCommand
    + GetAll() : IEnumerable<IConsoleCommand>
  }
  interface IConsoleCommand <<planned>> {
    + Name : string
    + Help : string
    + ExecuteAsync(args : ConsoleArguments) : Task
  }
  class ConsoleArguments <<planned>>
  class LoadProjectCommand <<planned>>
  class CreateMesh2DPolygonCommand <<planned>>
  class ConsoleHistory <<reuse>>
  class FieldsParser <<reuse>>
  class Token <<reuse>>
}

' =====================================================================
package "BazisAvaloniaGUI. Services" {
  class MessageLog <<boundary>>
}

package "BazisAvaloniaGUI. ProjectSession" {
  class ProjectSession <<boundary>>
}

package "BazisAvaloniaGUI. SceneView" {
  class SceneView <<boundary>>
  interface ICondPlayback <<boundary>>
  class CondView <<boundary>>
}

package "OperationalController. ProjectController" {
  interface IModelView <<boundary>>
}

' =====================================================================
MainWindowViewModel *-- NavigatorViewModel
MainWindowViewModel *-- PropertiesPanelViewModel
MainWindowViewModel *-- ConsoleViewModel

' навигатор
NavigatorViewModel *-- NavigatorTreeBuilder
NavigatorViewModel o-- NavigatorNode : Roots
NavigatorNode o-- NavigatorNode : Children
NavigatorNode *-- NodeAction
NavigatorNode <|-- SetNode
NavigatorNode <|-- ObjectNode
NavigatorNode <|-- CondNode
NavigatorNode <|-- TaskNode
NavigatorViewModel --> ProjectSession : ProjectChanged / DataChanged → Rebuild
NavigatorViewModel --> ActiveItem : Set(node.CreatePropertySource())
NavigatorViewModel --> PlayerViewModel : SetPlayback(node.CreatePlayback())
NavigatorNode ..> IPropertySource : создаёт
CondNode ..> ICondPlayback : одно условие
TaskNode ..> ICondPlayback : все условия
PlayerViewModel --> ICondPlayback
ICondPlayback ..> CondView : показывает кадр

' свойства
PropertiesPanelViewModel --> ActiveItem : Changed
ActiveItem o-- IPropertySource
IPropertySource <|.. EmptyPropertySource
IPropertySource <|.. SetPropertySource
IPropertySource <|.. CondPropertySource
IPropertySource <|.. SceneSelectionPropertySource
IPropertySource ..> PropertyRow
IPropertySource ..> PropertyValidation
PropertyRow *-- PropertyValue
PropertyValue <|-- TextValue
PropertyValue <|-- NumberValue
PropertyValue <|-- FlagValue
PropertyValue <|-- ChoiceValue
PropertyValue <|-- ActionValue
PropertyValue <|-- HeaderValue
SetPropertySource ..> ProjectSession : Apply → NotifyDataChanged
SceneSelectionPropertySource ..> IModelView : выделенные объекты
SceneView ..> ActiveItem : выбор на сцене

' консоль
ConsoleViewModel --> MessageLog : EntryAdded
ConsoleViewModel *-- ConsoleHistory
ConsoleViewModel --> ConsoleCommandRunner
ConsoleCommandRunner --> ConsoleCommandRegistry
ConsoleCommandRunner ..> FieldsParser : разбор строки
FieldsParser ..> Token
ConsoleCommandRunner --> MessageLog : результат, ошибки
ConsoleCommandRegistry o-- IConsoleCommand
IConsoleCommand ..> ConsoleArguments
IConsoleCommand <|.. LoadProjectCommand
IConsoleCommand <|.. CreateMesh2DPolygonCommand
LoadProjectCommand ..> ProjectSession : OpenAsync

' ---------------------------------------------------------------------
note top of NavigatorNode
  Узел сам знает свои свойства, плеер и действия.
  По умолчанию: EmptyPropertySource и «нет плеера».
  Заменяет TreeNode + NodeName, разбор Text.Split / Index
  и ~20 событий treeView_AfterSelect.
  Прочие узлы: Project, Geometry, Mesh, Groups, Group,
  Calculations, Calculation, Results, Result, Time.
end note

note top of ActiveItem
  Что сейчас показывает панель свойств.
  Ставят навигатор (узел) и сцена (выделение).
  Заменяет Tag == 1 и разбор navigator.SelectedNode.
end note

note bottom of IPropertySource
  Заменяет пары Get*Property / Change*Properties в BaseForm,
  маршрутизатор NavigatorSelection и PropertyChangedEventArgs.
  Заготовка — абстрактный PanelConverter.
  Вид строки выбирает DataTemplate по типу PropertyValue.
end note

note bottom of IConsoleCommand
  Заменяет switch по ~50 значениям GenCmd в ExecuteCommand.cs.
  Команда работает через ProjectSession, MessageLog и DataChanged,
  дерево и сцену напрямую не трогает.
end note

note bottom of CondView
  Цвет и оверлей условий, режимы проверки —
  GUI/Documents/CondView.md.
end note

@enduml
