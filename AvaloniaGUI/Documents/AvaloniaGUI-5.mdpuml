@startuml
title AvaloniaGUI-5 — строковые ресурсы интерфейса
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "AvaloniaGUI. Оболочка" {
  class MainWindow {
    - InitializeComponent() : void
  }
}
package "AvaloniaGUI. Сцена" {
  class SceneView
}
package "AvaloniaGUI. Локализация" {
  class Localization {
    + GetFormText(name) : string
    + GetErrorCaption() : string
  }
  class Resources {
    + ResourceManager : ResourceManager
  }
  class SceneViewLocalization {
    + CreateGroup : string
    + Select : string
  }
}
package "AvaloniaGUI. Базы данных" {
  class DatabaseControlResources {
    + Get(control, key) : string
  }
}

MainWindow --> Resources : общие подписи
SceneView --> SceneViewLocalization
SceneViewLocalization --> Localization
SceneViewLocalization --> Resources
Localization --> Resources : общие подписи

note bottom of Localization
  ResourceManager читает
  AvaloniaGUI.Shell.MainWindow.resources.
  [[AvaloniaGUI.mdpuml Назад к AvaloniaGUI]]
end note
@enduml
